# ==============================================================================
# NodeDrops.xyz — Environment Configuration Template
# Copy this file to .env or .env.local and fill in your actual values.
# NEVER commit .env or private credentials to source control.
# ==============================================================================

# Database Connection (MySQL 8.0)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/nodedrops"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Analytics 4 (Optional - Leave blank if not configured)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
