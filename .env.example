# Copy this file to .env for local development.
# Prisma CLI loads .env; Next.js also supports it.
# Never commit real database credentials or admin keys.

# TiDB Cloud / MySQL connection string.
# Replace placeholders with your own database values.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"

# Generate a unique random secret of at least 32 characters.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY="replace-with-a-random-secret-at-least-32-characters"

# Public canonical URL used by metadata and sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
