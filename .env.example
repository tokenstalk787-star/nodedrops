# ==============================================================================
# NodeDrops.xyz — Environment Configuration Template
# Copy this file to .env or .env.local and fill in your actual values.
# NEVER commit .env or private credentials to source control.
# ==============================================================================

# Database Connection (MySQL 8.0)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/nodedrops"

# Admin session signing secret (generate a unique 32-byte secret)
SESSION_SECRET="change-this-to-a-secure-random-session-secret"

# Private research-agent API key (generate 32+ random bytes; server-side only)
NODEDROPS_AGENT_API_KEY="change-this-to-a-long-random-agent-api-key"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Analytics 4 (Optional - Leave blank if not configured)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
